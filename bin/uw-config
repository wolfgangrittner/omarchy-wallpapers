#!/bin/bash
# Read/write the Unsplash Wallpapers plugin config.
#
# The config lives under ~/.local/state (not ~/.config) so an access key
# never lands in a dotfiles repo by accident. The file is kept 0600.
#
#   uw-config get                print the whole config as JSON
#   uw-config set <key> <val>    set one key (numeric values stay numeric)
#   uw-config setjson <key> <j>  set one key to a raw JSON value (arrays etc.)
#   uw-config unset <key>...     remove keys
#   uw-config path               print the config path

set -euo pipefail

CONFIG="$HOME/.local/state/omarchy/settings/unsplash.json"

ensure_config() {
  mkdir -p "$(dirname "$CONFIG")"
  if [[ ! -f $CONFIG ]]; then
    (
      umask 077
      echo '{}' >"$CONFIG"
    )
  fi
  chmod 600 "$CONFIG" 2>/dev/null || true
}

# Replace the config with a candidate file, but only once it is confirmed to
# be a JSON object. This file holds the access key, so a malformed jq
# invocation must never be able to truncate it.
commit_config() {
  local tmp="$1"
  if [[ ! -s $tmp ]] || ! jq -e 'type == "object"' "$tmp" >/dev/null 2>&1; then
    rm -f "$tmp"
    echo "uw-config: refusing to write invalid config; left $CONFIG untouched" >&2
    exit 1
  fi
  chmod 600 "$tmp"
  mv "$tmp" "$CONFIG"
}

case "${1:-get}" in
path)
  echo "$CONFIG"
  ;;

get)
  ensure_config
  cat "$CONFIG"
  ;;

set)
  key="${2:?usage: uw-config set <key> <value>}"
  value="${3-}"
  ensure_config

  tmp="$(mktemp "${CONFIG}.XXXXXX")"
  # Integers are written as JSON numbers so the QML side does not have to
  # coerce them back on every read; everything else is a string.
  if [[ $value =~ ^-?[0-9]+$ ]]; then
    jq --arg k "$key" --argjson v "$value" '.[$k] = $v' "$CONFIG" >"$tmp"
  else
    jq --arg k "$key" --arg v "$value" '.[$k] = $v' "$CONFIG" >"$tmp"
  fi
  commit_config "$tmp"
  ;;

setjson)
  key="${2:?usage: uw-config setjson <key> <json>}"
  value="${3-}"
  ensure_config

  # Reject malformed JSON up front for a clearer error than commit_config's.
  if ! jq -e . >/dev/null 2>&1 <<<"$value"; then
    echo "uw-config: not valid JSON: $value" >&2
    exit 1
  fi

  tmp="$(mktemp "${CONFIG}.XXXXXX")"
  jq --arg k "$key" --argjson v "$value" '.[$k] = $v' "$CONFIG" >"$tmp"
  commit_config "$tmp"
  ;;

unset)
  shift || true
  [[ $# -gt 0 ]] || { echo "usage: uw-config unset <key>..." >&2; exit 1; }
  ensure_config

  tmp="$(mktemp "${CONFIG}.XXXXXX")"
  # The config is fed on stdin: with --args, every trailing argument is a
  # positional string, so passing it as a file argument would silently make
  # jq read an empty stdin instead.
  jq 'delpaths([$ARGS.positional[] | [.]])' --args "$@" <"$CONFIG" >"$tmp"
  commit_config "$tmp"
  ;;

*)
  echo "usage: uw-config [get|set <key> <value>|setjson <key> <json>|unset <key>...|path]" >&2
  exit 1
  ;;
esac
