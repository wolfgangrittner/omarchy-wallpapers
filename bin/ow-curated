#!/bin/bash
# Resolve the curated grid: for each search term, find the Unsplash collection
# with the most photos and print them as a JSON array.
#
# Collection ids are never hardcoded — they are discovered here on first run
# and cached in the config, so the grid follows Unsplash rather than a list
# that silently rots.
#
#   ow-curated --key <access-key> [--min N] [term...]
#
# --min is the preferred floor of fetchable photos (default 50); if nothing
# clears it, the largest usable match is taken anyway.
#
# Prints: [{ term, id, title, totalPhotos, coverUrl, coverColor, curator }, …]
# A term that matches nothing is skipped rather than failing the whole run.

set -euo pipefail

key=""
min="50"
terms=()

while [[ $# -gt 0 ]]; do
  case "$1" in
  --key) key="${2-}"; shift 2 ;;
  --min) min="${2-}"; shift 2 ;;
  *) terms+=("$1"); shift ;;
  esac
done

[[ $min =~ ^[0-9]+$ ]] || min=50

[[ -n $key ]] || { echo "ow-curated: --key is required" >&2; exit 1; }
if [[ ${#terms[@]} -eq 0 ]]; then
  terms=(wallpapers nature architecture space beach "black & white")
fi

out='[]'

for term in "${terms[@]}"; do
  enc="$(jq -rn --arg t "$term" '$t|@uri')"

  if ! resp="$(curl -sS --max-time 20 \
    -H "Authorization: Client-ID $key" \
    "https://api.unsplash.com/search/collections?query=$enc&per_page=10")"; then
    continue
  fi

  # Biggest collection wins — but counted in photos a free API key can
  # actually fetch. The largest "wallpapers" collection belongs to @plus and
  # is entirely Unsplash+ premium, so /photos/random answers 404 for it. Rank
  # on total_photos minus total_plus and drop anything with nothing free left.
  #
  # Collections without a cover photo are skipped too: the grid is all
  # thumbnails, so an entry that cannot render is worse than one fewer.
  # Prefer a collection with a real body of photos; fall back to the best of
  # whatever is usable so a thin search term still yields a tile.
  entry="$(jq -c --arg term "$term" --argjson min "$min" '
    ((.results // [])
      | map(select(.id != null and .cover_photo.urls.small != null))
      | map({ c: ., free: ((.total_photos // 0) - (.total_plus // 0)) })
      | map(select(.free > 0))) as $usable
    | ([$usable[] | select(.free >= $min)]) as $good
    | (if ($good | length) > 0 then $good else $usable end)
    | sort_by(-.free)
    | .[0] // empty
    | {
        term: $term,
        id: (.c.id | tostring),
        title: (.c.title // $term),
        totalPhotos: .free,
        coverUrl: .c.cover_photo.urls.small,
        coverColor: (.c.cover_photo.color // "#1b1b1b"),
        curator: (.c.user.username // "")
      }' <<<"$resp" 2>/dev/null)" || entry=""

  [[ -n $entry ]] && out="$(jq -c --argjson e "$entry" '. + [$e]' <<<"$out")"
done

printf '%s\n' "$out"
