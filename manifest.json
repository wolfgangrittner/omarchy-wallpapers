{
  "schemaVersion": 1,
  "id": "wolfgangrittner.omarchy-wallpapers",
  "name": "Omarchy Wallpapers",
  "version": "1.0.0",
  "author": "Wolfgang Rittner",
  "license": "MIT",
  "description": "Browse photos from Unsplash in the bar and set them as your Omarchy background.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Omarchy Wallpapers",
    "description": "Pick curated collections and set photos as your background.",
    "category": "Appearance",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "columns": 3,
      "perPage": 20
    },
    "schema": [
      {
        "key": "columns",
        "type": "integer",
        "label": "Grid columns (curated and history)",
        "min": 2,
        "max": 5,
        "step": 1,
        "defaultValue": 3
      },
      {
        "key": "perPage",
        "type": "integer",
        "label": "Collection results per page",
        "min": 6,
        "max": 30,
        "step": 3,
        "defaultValue": 20
      }
    ]
  }
}
